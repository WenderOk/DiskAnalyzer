<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiskAnalyzer.UI.ViewModels"
             x:Class="DiskAnalyzer.UI.Views.SearchView"
             x:DataType="vm:SearchViewModel">

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Grid.Column="0" Text="{Binding Text, Mode=TwoWay}"
                 Watermark="Строка поиска по имени и содержимому" />
        <TextBox Grid.Column="1" Width="120" Margin="8,0,0,0"
                 Text="{Binding Extension, Mode=TwoWay}" Watermark=".ext" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Найти" Command="{Binding SearchCommand}" />
        <CheckBox Content="Искать по содержимому" IsChecked="{Binding SearchContent, Mode=TwoWay}" />
        <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" />
    </StackPanel>

    <ListBox ItemsSource="{Binding Results}">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="vm:SearchResultViewModel">
          <StackPanel Margin="4,6">
            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding FullPath}" Foreground="Gray" />
            <TextBlock>
              <Run Text="{Binding DisplaySize}" />
              <Run Text="·" />
              <Run Text="{Binding DisplayDate}" />
            </TextBlock>
            <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxHeight="60" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>

</UserControl>