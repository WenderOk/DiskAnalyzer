<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiskAnalyzer.UI.ViewModels"
             x:Class="DiskAnalyzer.UI.Views.IndexingView"
             x:DataType="vm:IndexingViewModel">

  <StackPanel Margin="16" Spacing="8">
    <TextBlock Text="{Binding Path}" FontSize="16" FontWeight="SemiBold" />
    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="22" />
    <TextBlock Text="{Binding CurrentPath}" TextTrimming="CharacterEllipsis" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="{Binding ProcessedInfo}" />
      <Button Content="Отмена" Command="{Binding CancelCommand}" />
    </StackPanel>
    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" />
  </StackPanel>

</UserControl>